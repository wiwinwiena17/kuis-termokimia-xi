function useAudience(){
  if(!state.lifelines.audience || state.locked) return;
  state.lifelines.audience = false;
  const q = QUESTIONS[state.currentIndex];
  // Generate percentages with bias toward correct answer
  const correctBias = 0.7 + Math.random() * 0.15; // 70-85%
  const percents = [0,0,0,0];
  percents[q.answerIndex] = Math.round(correctBias * 100);
  let remaining = 100 - percents[q.answerIndex];
  const others = [0,1,2,3].filter(i => i !== q.answerIndex);
  // distribute remaining randomly
  const r1 = Math.random() * remaining * 0.6;
  const r2 = Math.random() * (remaining - r1) * 0.7;
  const r3 = remaining - r1 - r2;
  percents[others[0]] = Math.round(r1);
  percents[others[1]] = Math.round(r2);
  percents[others[2]] = Math.round(r3);
  // fix rounding
  const sum = percents.reduce((a,b)=>a+b,0);
  percents[q.answerIndex] += (100 - sum);
  
  saveState();
  renderLifelines();
  showAudienceModal(percents);
