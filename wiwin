/* =========================================================
   START / END MODAL
   ========================================================= */
function showStartModal(timerDefault = true){
  const body = `
    <p>Selamat datang di <b>Termokimia Millionaire</b>!</p>
    <p>Jawab 15 soal Termokimia kelas XI dalam 3 stage untuk meraih nilai tertinggi. Gunakan 3 bantuan: <b>50:50</b>, <b>Tanya Penonton</b>, dan <b>Telepon Teman</b>.</p>
    <p class="hint">💡 Nilai aman: 1.000 (Stage 1) • 32.000 (Stage 2) • 1.000.000 (Stage 3)</p>
    <label style="display:flex;flex-direction:column;gap:4px;margin-top:10px;font-size:13px">
      Nama Pemain
      <input type="text" id="playerInput" placeholder="Nama kamu" maxlength="30" autocomplete="off">
    </label>
    <label class="check-row">
      <input type="checkbox" id="timerCheck" ${timerDefault ? 'checked' : ''}>
      Aktifkan timer 45 detik per soal
    </label>
    <p class="hint">Tanpa timer = mode santai.</p>
  `;
  showModal('💎 Termokimia Millionaire', body, [
    { label:'▶ Mulai Bermain', class:'btn-primary', fn: () => {
        const nameEl = document.getElementById('playerInput');
        const timerEl = document.getElementById('timerCheck');
        const name = (nameEl && nameEl.value.trim()) || 'Siswa';
        const timerOn = timerEl ? timerEl.checked : true;
        closeModal();
        startNewGame(name, timerOn);
      }
    }
  ]);
}

function showContinueModal(saved){
  const availableLifelines = Object.values(saved.lifelines).filter(v=>v).length;
  const body = `
    <p>Ditemukan permainan yang belum selesai:</p>
    <div class="summary-grid">
      <div class="summary-item"><div class="label">SOAL</div><div class="value">${saved.currentIndex + 1}/${TOTAL_QUESTIONS}</div></div>
      <div class="summary-item"><div class="label">NILAI</div><div class="value">${formatScore(saved.score)}</div></div>
      <div class="summary-item"><div class="label">STAGE</div><div class="value">${saved.stage}</div></div>
      <div class="summary-item"><div class="label">BANTUAN</div><div class="value">${availableLifelines}/3</div></div>
    </div>
    <p class="hint">Lanjutkan permainan atau mulai baru?</p>
  `;
  showModal('🔄 Lanjutkan Permainan?', body, [
    { label:'▶ Lanjutkan', class:'btn-primary', fn: () => { closeModal(); resumeGame(saved); } },
    { label:'🔄 Mulai Baru', class:'btn-secondary', fn: () => { closeModal(); clearState(); state = null; showStartModal(true); } }
  ]);
}

function showEndModal(reason){
  stopTimer();
  let title, bodyText;
  if(reason === 'won'){
    title = '🏆 Selamat, Anda Menang!';
    bodyText = 'Luar biasa! Anda berhasil menjawab 15 soal Termokimia dengan benar dan membawa pulang nilai tertinggi <b>1.000.000</b>!';
  } else if(reason === 'lost'){
    title = '💔 Permainan Berakhir';
    bodyText = `Sayang sekali! Anda menjawab salah, tetapi masih membawa nilai aman sebesar <b>${formatScore(state.score)}</b>.`;
  } else if(reason === 'walked-away'){
    title = '🚪 Anda Berhenti';
    bodyText = `Anda memilih berhenti dan membawa pulang nilai <b>${formatScore(state.score)}</b>.`;
  } else {
    title = '⏰ Waktu Habis';
    bodyText = `Waktu Anda habis! Nilai yang Anda bawa pulang: <b>${formatScore(state.score)}</b>.`;
  }

  const correct = state.history.filter(h => h.correct).length;
  const answered = state.history.length;
  const avgTime = answered ? Math.round(state.history.reduce((s,h)=>s+h.timeMs,0)/answered/1000) : 0;

  const body = `
    <p>${bodyText}</p>
    <div class="summary-grid">
      <div class="summary-item"><div class="label">NILAI AKHIR</div><div class="value" style="color:#fbbf24">${formatScore(state.score)}</div></div>
      <div class="summary-item"><div class="label">BENAR</div><div class="value">${correct}/${answered}</div></div>
      <div class="summary-item"><div class="label">SOAL DIJAWAB</div><div class="value">${answered}</div></div>
      <div class="summary-item"><div class="label">RATA-RATA WAKTU</div><div class="value">${avgTime}s</div></div>
    </div>
  `;
  showModal(title, body, [
    { label:'⬇ Unduh Hasil (.json)', class:'btn-primary', fn: downloadJSON },
    { label:'🔄 Main Lagi', class:'btn-secondary', fn: () => {
        closeModal(); clearState(); state = null; showStartModal(true);
      }
    }
  ]);
}

/* =========================================================
   GAME FLOW
   ========================================================= */
function startNewGame(playerName, timerOn){
  state = {
    version: 1,
    player: playerName,
    startedAt: new Date().toISOString(),
    finishedAt: null,
    currentIndex: 0,
    score: 0,
    stage: 1,
    lifelines: { fifty:true, audience:true, phone:true },
    history: [],
    status: 'in-progress',
    timerEnabled: timerOn,
    selectedOption: null,
    locked: false,
    hiddenOptions: []
  };
  saveState();
  render(true);
}

function resumeGame(saved){
  state = saved;
  state.hiddenOptions = state.hiddenOptions || [];
  state.selectedOption = state.selectedOption ?? null;
  state.locked = state.locked ?? false;
  state.timerEnabled = state.timerEnabled ?? true;
  // Jika ter-lock tapi belum teradvance (tab ditutup saat feedback), proses ulang
  if(state.locked){
    const last = state.history[state.history.length - 1];
    if(last && last.q === QUESTIONS[state.currentIndex].id){
      if(last.correct){
        if(state.currentIndex >= TOTAL_QUESTIONS - 1){
          state.score = SCORE_LADDER[14];
          state.status = 'won';
          state.finishedAt = new Date().toISOString();
          saveState();
          render(false);
          setTimeout(() => showEndModal('won'), 100);
          return;
        }
        state.score = SCORE_LADDER[state.currentIndex];
        state.currentIndex++;
        state.stage = QUESTIONS[state.currentIndex].stage;
        state.selectedOption = null;
        state.locked = false;
        state.hiddenOptions = [];
      } else {
        state.score = getSafeScore(state.currentIndex);
        state.status = 'lost';
        state.finishedAt = new Date().toISOString();
        saveState();
        render(false);
        setTimeout(() => showEndModal('lost'), 100);
        return;
      }
    } else {
      state.locked = false;
      state.selectedOption = null;
    }
  }
  saveState();
  render(true);
}

/* =========================================================
   DOWNLOAD JSON
   ========================================================= */
function downloadJSON(){
  if(!state) return;
  const data = {
    ...state,
    summary: {
      totalQuestions: TOTAL_QUESTIONS,
      answered: state.history.length,
      correct: state.history.filter(h => h.correct).length,
      wrong: state.history.filter(h => !h.correct && h.chosen !== null).length,
      timeout: state.history.filter(h => h.chosen === null).length,
      avgTimeMs: state.history.length
        ? Math.round(state.history.reduce((s,h)=>s+h.timeMs,0) / state.history.length)
        : 0
    }
  };
  const blob = new Blob([JSON.stringify(data, null, 2)], { type:'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  const dateStr = new Date().toISOString().slice(0,10);
  const safeName = (state.player || 'siswa').replace(/[^a-zA-Z0-9]+/g,'-');
  a.href = url;
  a.download = `hasil-termokimia-${safeName}-${dateStr}.json`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

/* =========================================================
   BOOT
   ========================================================= */
function boot(){
  initThree();

  document.getElementById('btnLock').addEventListener('click', showConfirmModal);
  document.getElementById('btnWalk').addEventListener('click', showWalkAwayConfirm);
  document.getElementById('btnDownload').addEventListener('click', () => { if(state) downloadJSON(); });
  document.getElementById('btnReset').addEventListener('click', () => {
    showModal('↺ Reset Permainan?', '<p>Semua progress yang tersimpan akan dihapus. Lanjutkan?</p>', [
      { label:'🗑 Ya, Reset', class:'btn-danger', fn: () => {
          closeModal();
          stopTimer();
          clearState();
          state = null;
          showStartModal(true);
        }
      },
      { label:'Batal', class:'btn-secondary', fn: closeModal }
    ]);
  });
  document.getElementById('btnTimer').addEventListener('click', () => {
    if(!state) return;
    state.timerEnabled = !state.timerEnabled;
    saveState();
    render(true);
  });

  const saved = loadState();
  if(saved && saved.status === 'in-progress'){
    showContinueModal(saved);
  } else {
    showStartModal(true);
  }
}

boot();
</script>
