js
function animate(t){
  requestAnimationFrame(animate);
  const time = t * 0.001;
  // rotate atom
  if(atomGroup){
    atomGroup.rotation.y += 0.003;
    atomGroup.rotation.x = Math.sin(time*0.5) * 0.2;
    // move electrons
    atomGroup.children.forEach(child => {
      if(child.userData && child.userData.isOrbit){
        child.children.forEach(c => {
          if(c.userData && c.userData.isElectron){
            const a = time * child.userData.spinSpeed + c.userData.offset;
            c.position.x = Math.cos(a) * c.userData.r;
            c.position.y = Math.sin(a) * c.userData.r;
            c.position.z = 0;
          }
        });
      }
    });
    // color transition
    if(window._nucleusMat){
      window._nucleusMat.color.lerp(atomColorTarget, 0.05);
    }
  }
  renderer.render(scene, camera);
}
