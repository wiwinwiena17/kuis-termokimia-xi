  const q = QUESTIONS[state.currentIndex];
  const correctBias = 0.7 + Math.random() * 0.15; // 70-85%
  const percents = [0,0,0,0];
  percents[q.answerIndex] = Math.round(correctBias * 100);
  
  const remaining = 100 - percents[q.answerIndex];
  const others = [0,1,2,3].filter(i => i !== q.answerIndex);
  // distribute remaining among others with randomness
  const weights = [Math.random(), Math.random(), Math.random()];
  const wSum = weights[0]+weights[1]+weights[2];
  const shares = weights.map(w => Math.round(remaining * w / wSum));
  // fix sum
  const shareSum = shares.reduce((a,b)=>a+b,0);
  shares[0] += remaining - shareSum;
  
  percents[others[0]] = shares[0];
  percents[others[1]] = shares[1];
  percents[others[2]] = shares[2];
  
