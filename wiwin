/* =========================================================
   STORAGE HELPER (fallback in-memory jika localStorage diblokir)
   ========================================================= */
const memStore = {};
function storageGet(k){ try { return localStorage.getItem(k); } catch(e){ return memStore[k] || null; } }
function storageSet(k,v){ try { localStorage.setItem(k,v); } catch(e){ memStore[k] = v; } }
function storageRemove(k){ try { localStorage.removeItem(k); } catch(e){ delete memStore[k]; } }

/* =========================================================
   STATE
   ========================================================= */
let state = null;
let timerId = null;
let timeLeft = TIME_LIMIT;

function saveState(){ try { storageSet(STORAGE_KEY, JSON.stringify(state)); } catch(e){} }
function loadState(){ try { const raw = storageGet(STORAGE_KEY); return raw ? JSON.parse(raw) : null; } catch(e){ return null; } }
function clearState(){ storageRemove(STORAGE_KEY); }

/* =========================================================
   UTIL
   ========================================================= */
function formatScore(n){ return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.'); }
function shuffle(arr){ for(let i=arr.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [arr[i],arr[j]]=[arr[j],arr[i]]; } return arr; }
function getSafeScore(currentIndex){
  let safe = 0;
  for(const sp of SAFE_POINTS){ if(sp < currentIndex) safe = SCORE_LADDER[sp]; }
  return safe;
}
function getStageColor(stage){ return stage === 3 ? 0xfbbf24 : (stage === 2 ? 0x818cf8 : 0x3b82f6); }

/* =========================================================
   THREE.JS — BACKGROUND ATOM
   ========================================================= */
let renderer = null, scene = null, camera = null, atomGroup = null, nucleusMat = null;
let atomColorTarget = { r:0x3b/255, g:0x82/255, b:0xf6/255 };
let currentColorObj = { r:0x3b/255, g:0x82/255, b:0xf6/255 };
let atomRevertTimer = null;

function hexToRgb(hex){ return { r:((hex>>16)&255)/255, g:((hex>>8)&255)/255, b:(hex&255)/255 }; }

function initThree(){
  const canvas = document.getElementById('bg');
  if(typeof THREE === 'undefined'){ canvas.style.display = 'none'; return; }
  try {
    renderer = new THREE.WebGLRenderer({ canvas, antialias:true, alpha:true, powerPreference:'low-power' });
  } catch(e){
    canvas.style.display = 'none';
    document.body.style.background = 'linear-gradient(135deg,#0a0e1a,#1e1b4b,#0a0e1a)';
    return;
  }
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);

  scene = new THREE.Scene();
  camera = new THREE.PerspectiveCamera(55, window.innerWidth/window.innerHeight, 0.1, 100);
  camera.position.z = 6.5;

  atomGroup = new THREE.Group();
  scene.add(atomGroup);

  // Inti atom (wireframe icosahedron)
  const nGeo = new THREE.IcosahedronGeometry(0.85, 1);
  nucleusMat = new THREE.MeshBasicMaterial({ color: 0x3b82f6, wireframe: true, transparent:true, opacity:0.75 });
  atomGroup.add(new THREE.Mesh(nGeo, nucleusMat));

  // 3 orbit + elektron
  const orbitColors = [0x60a5fa, 0x818cf8, 0x38bdf8];
  for(let i=0; i<3; i++){
    const g = new THREE.Group();
    const r = 1.9 + i * 0.45;
    const pts = [];
    for(let j=0; j<=48; j++){
      const a = (j/48) * Math.PI * 2;
      pts.push(new THREE.Vector3(Math.cos(a)*r, Math.sin(a)*r, 0));
    }
    const lineGeo = new THREE.BufferGeometry().setFromPoints(pts);
    const lineMat = new THREE.LineBasicMaterial({ color: orbitColors[i], transparent:true, opacity:0.35 });
    g.add(new THREE.Line(lineGeo, lineMat));

    for(let k=0; k<2; k++){
      const eGeo = new THREE.SphereGeometry(0.1, 10, 10);
      const eMat = new THREE.MeshBasicMaterial({ color: orbitColors[i] });
      const e = new THREE.Mesh(eGeo, eMat);
      e.userData = { isElectron:true, r:r, offset: k*Math.PI };
      g.add(e);
    }
    g.rotation.x = (Math.PI/3) * i - Math.PI/3;
    g.rotation.y = (Math.PI/4) * i;
    g.userData = { isOrbit:true, spinSpeed: 0.5 + i*0.35 };
    atomGroup.add(g);
  }

  window.addEventListener('resize', onResize);
  requestAnimationFrame(animate);
}

function onResize(){
  if(!renderer) return;
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
}

let lastFrame = 0;
function animate(t){
  requestAnimationFrame(animate);
  if(!renderer || !atomGroup) return;
  // throttle ~30 FPS untuk hemat baterai HP
  if(t - lastFrame < 33) return;
  lastFrame = t;
  const time = t * 0.001;

  atomGroup.rotation.y += 0.004;
  atomGroup.rotation.x = Math.sin(time*0.4) * 0.18;

  atomGroup.children.forEach(child => {
    if(child.userData && child.userData.isOrbit){
      const sp = child.userData.spinSpeed;
      child.children.forEach(c => {
        if(c.userData && c.userData.isElectron){
          const a = time * sp + c.userData.offset;
          c.position.x = Math.cos(a) * c.userData.r;
          c.position.y = Math.sin(a) * c.userData.r;
        }
      });
    }
  });

  // transisi warna inti atom
  if(nucleusMat){
    currentColorObj.r += (atomColorTarget.r - currentColorObj.r) * 0.08;
    currentColorObj.g += (atomColorTarget.g - currentColorObj.g) * 0.08;
    currentColorObj.b += (atomColorTarget.b - currentColorObj.b) * 0.08;
    nucleusMat.color.setRGB(currentColorObj.r, currentColorObj.g, currentColorObj.b);
  }

  renderer.render(scene, camera);
}

function flashAtom(hex){
  const c = hexToRgb(hex);
  atomColorTarget = c;
  if(atomRevertTimer) clearTimeout(atomRevertTimer);
  atomRevertTimer = setTimeout(() => {
    atomColorTarget = hexToRgb(getStageColor(state ? state.stage : 1));
  }, 2200);
}
function setAtomStageColor(){
  atomColorTarget = hexToRgb(getStageColor(state ? state.stage : 1));
}

/* =========================================================
   RENDER — HEADER & KARTU SOAL
   ========================================================= */
function render(startTimerFlag = true){
  if(!state) return;
  const q = QUESTIONS[state.currentIndex];
  if(!q) return;

  document.getElementById('stageBadge').textContent = `Stage ${q.stage}`;
  document.getElementById('qBadge').textContent = `Soal ${state.currentIndex + 1}/${TOTAL_QUESTIONS}`;
  document.getElementById('scoreVal').textContent = formatScore(state.score);

  const btnTimer = document.getElementById('btnTimer');
  btnTimer.textContent = state.timerEnabled ? '⏱' : '⏸';
  btnTimer.style.opacity = state.timerEnabled ? 1 : 0.5;

  document.getElementById('questionText').textContent = q.question;

  const fb = document.getElementById('feedback');
  fb.className = 'feedback';
  fb.textContent = '';

  renderOptions();
  renderLifelines();

  document.getElementById('btnLock').disabled = state.selectedOption === null || state.locked;
  document.getElementById('btnWalk').disabled = !!state.locked;

  const showTimer = state.timerEnabled && !state.locked;
  document.getElementById('timerBar').classList.toggle('active', showTimer);
  document.getElementById('timerText').classList.toggle('active', showTimer);
  if(showTimer){
    if(startTimerFlag) startTimer();
  } else {
    stopTimer();
  }
  setAtomStageColor();
}

function renderOptions(){
  const q = QUESTIONS[state.currentIndex];
  const container = document.getElementById('options');
  container.innerHTML = '';
  const letters = ['A','B','C','D'];
  q.options.forEach((opt, i) => {
    const btn = document.createElement('button');
    btn.className = 'option';
    btn.type = 'button';
    const hidden = state.hiddenOptions && state.hiddenOptions.includes(i);
    if(hidden) btn.classList.add('hidden-opt');
    if(state.selectedOption === i && !state.locked) btn.classList.add('selected');
    btn.disabled = state.locked || hidden;
    btn.innerHTML = `<span class="letter">${letters[i]}</span><span class="text">${opt}</span>`;
    if(!state.locked && !hidden){
      btn.addEventListener('click', () => selectOption(i));
    }
    container.appendChild(btn);
  });
}

function renderLifelines(){
  const container = document.getElementById('lifelines');
  container.innerHTML = '';
  const items = [
    { key:'fifty', icon:'50:50', label:'50:50', fn: useFifty },
    { key:'audience', icon:'👥', label:'Tanya Penonton', fn: useAudience },
    { key:'phone', icon:'📞', label:'Telepon Teman', fn: usePhone }
  ];
  items.forEach(it => {
    const btn = document.createElement('button');
    btn.className = 'lifeline';
    btn.type = 'button';
    const available = state.lifelines[it.key] && !state.locked;
    btn.disabled = !available;
    btn.innerHTML = `<span class="icon">${it.icon}</span><span>${it.label}</span>`;
    if(available) btn.addEventListener('click', it.fn);
    container.appendChild(btn);
  });
}

/* =========================================================
   INTERAKSI JAWABAN
   ========================================================= */
function selectOption(i){
  if(state.locked) return;
  if(state.hiddenOptions && state.hiddenOptions.includes(i)) return;
  state.selectedOption = i;
  document.querySelectorAll('.option').forEach((btn, idx) => {
    btn.classList.toggle('selected', idx === i);
  });
  updateLockButton();
}
function updateLockButton(){
  document.getElementById('btnLock').disabled = state.selectedOption === null || state.locked;
}

function showConfirmModal(){
  const q = QUESTIONS[state.currentIndex];
  const letters = ['A','B','C','D'];
  const chosen = letters[state.selectedOption];
  const chosenText = q.options[state.selectedOption];
  const body = `
    <p>Apakah Anda yakin dengan jawaban <b>${chosen}. ${chosenText}</b>?</p>
    <p class="hint">Setelah dikunci, jawaban tidak dapat diubah.</p>
  `;
  showModal('🔒 Kunci Jawaban?', body, [
    { label:'✅ Ya, Kunci!', class:'btn-primary', fn: confirmLock },
    { label:'Batal', class:'btn-secondary', fn: closeModal }
  ]);
}

function confirmLock(){
  closeModal();
  stopTimer();
  document.getElementById('timerBar').classList.remove('active');
  document.getElementById('timerText').classList.remove('active');
  state.locked = true;

  const q = QUESTIONS[state.currentIndex];
  const chosen = state.selectedOption;
  const isCorrect = chosen === q.answerIndex;

  // Warnai tombol opsi
  document.querySelectorAll('.option').forEach((btn, i) => {
    btn.disabled = true;
    btn.classList.remove('selected');
    if(i === q.answerIndex) btn.classList.add('correct');
    if(i === chosen && !isCorrect) btn.classList.add('wrong');
  });

  // Feedback edukatif
  const fb = document.getElementById('feedback');
  fb.innerHTML = (isCorrect ? '✅ <b>Benar!</b> ' : '❌ <b>Salah.</b> ') + q.explanation;
  fb.className = 'feedback show ' + (isCorrect ? 'correct' : 'wrong');

  flashAtom(isCorrect ? 0x22c55e : 0xef4444);

  const timeUsed = state.timerEnabled ? Math.round((TIME_LIMIT - Math.max(0,timeLeft)) * 1000) : 0;
  state.history.push({
    q: q.id,
    chosen: ['A','B','C','D'][chosen],
    correct: isCorrect,
    timeMs: timeUsed
  });

  document.getElementById('btnLock').disabled = true;
  document.getElementById('btnWalk').disabled = true;
  document.querySelectorAll('.lifeline').forEach(b => b.disabled = true);

  if(isCorrect){
    setTimeout(() => {
      if(state.currentIndex >= TOTAL_QUESTIONS - 1){
        state.score = SCORE_LADDER[14];
        state.status = 'won';
        state.finishedAt = new Date().toISOString();
        saveState();
        showEndModal('won');
      } else {
        state.score = SCORE_LADDER[state.currentIndex];
        state.currentIndex++;
        state.stage = QUESTIONS[state.currentIndex].stage;
        state.selectedOption = null;
        state.locked = false;
        state.hiddenOptions = [];
        saveState();
        render(true);
      }
    }, 2400);
  } else {
    setTimeout(() => {
      state.score = getSafeScore(state.currentIndex);
      state.status = 'lost';
      state.finishedAt = new Date().toISOString();
      saveState();
      showEndModal('lost');
    }, 2400);
  }
}

function showWalkAwayConfirm(){
  if(state.locked) return;
  const currentScore = state.currentIndex > 0 ? SCORE_LADDER[state.currentIndex - 1] : 0;
  const body = `<p>Yakin ingin berhenti? Anda akan membawa pulang nilai <b>${formatScore(currentScore)}</b>.</p>`;
  showModal('🚪 Berhenti Bermain?', body, [
    { label:'✅ Ya, Berhenti', class:'btn-danger', fn: () => { closeModal(); walkAway(); } },
    { label:'Lanjut Main', class:'btn-secondary', fn: closeModal }
  ]);
}

function walkAway(){
  stopTimer();
  state.score = state.currentIndex > 0 ? SCORE_LADDER[state.currentIndex - 1] : 0;
  state.status = 'walked-away';
  state.finishedAt = new Date().toISOString();
  saveState();
  showEndModal('walked-away');
}

/* =========================================================
   TIMER
   ========================================================= */
function startTimer(){
  stopTimer();
  timeLeft = TIME_LIMIT;
  updateTimerDisplay();
  timerId = setInterval(() => {
    timeLeft -= 0.1;
    updateTimerDisplay();
    if(timeLeft <= 0){ stopTimer(); timeUp(); }
  }, 100);
}
function stopTimer(){ if(timerId){ clearInterval(timerId); timerId = null; } }
function updateTimerDisplay(){
  const pct = Math.max(0, timeLeft / TIME_LIMIT) * 100;
  document.getElementById('timerFill').style.width = pct + '%';
  document.getElementById('timerText').textContent = `⏱ ${Math.ceil(Math.max(0, timeLeft))}s`;
}
function timeUp(){
  if(!state || state.locked) return;
  state.locked = true;
  const q = QUESTIONS[state.currentIndex];
  state.history.push({ q:q.id, chosen:null, correct:false, timeMs: TIME_LIMIT*1000 });
  state.score = getSafeScore(state.currentIndex);
  state.status = 'timeout';
  state.finishedAt = new Date().toISOString();
  saveState();
  document.querySelectorAll('.option').forEach((btn, i) => {
    btn.disabled = true;
    if(i === q.answerIndex) btn.classList.add('correct');
  });
  const fb = document.getElementById('feedback');
  fb.innerHTML = '⏰ <b>Waktu habis!</b> ' + q.explanation;
  fb.className = 'feedback show wrong';
  flashAtom(0xef4444);
  setTimeout(() => showEndModal('timeout'), 2200);
}

/* =========================================================
   LIFELINES
   ========================================================= */
function useFifty(){
  if(!state || !state.lifelines.fifty || state.locked) return;
  state.lifelines.fifty = false;
  const q = QUESTIONS[state.currentIndex];
  const wrong = [0,1,2,3].filter(i => i !== q.answerIndex);
  shuffle(wrong);
  state.hiddenOptions = wrong.slice(0, 2);
  if(state.hiddenOptions.includes(state.selectedOption)) state.selectedOption = null;
  saveState();
  renderLifelines();
  renderOptions();
  updateLockButton();
}

function useAudience(){
  if(!state || !state.lifelines.audience || state.locked) return;
  state.lifelines.audience = false;
  const q = QUESTIONS[state.currentIndex];
  const correctBias = 0.7 + Math.random() * 0.15;
  const percents = [0,0,0,0];
  percents[q.answerIndex] = Math.round(correctBias * 100);
  const remaining = 100 - percents[q.answerIndex];
  const others = [0,1,2,3].filter(i => i !== q.answerIndex);
  const w = [Math.random(), Math.random(), Math.random()];
  const wSum = w[0]+w[1]+w[2] || 1;
  const shares = w.map(x => Math.round(remaining * x / wSum));
  const sSum = shares.reduce((a,b)=>a+b,0);
  shares[0] += remaining - sSum;
  percents[others[0]] = shares[0];
  percents[others[1]] = shares[1];
  percents[others[2]] = shares[2];
  saveState();
  renderLifelines();
  showAudienceModal(percents);
}

function usePhone(){
  if(!state || !state.lifelines.phone || state.locked) return;
  state.lifelines.phone = false;
  const q = QUESTIONS[state.currentIndex];
  const isRight = Math.random() < 0.8;
  let friendIdx;
  if(isRight){ friendIdx = q.answerIndex; }
  else {
    const wrong = [0,1,2,3].filter(i => i !== q.answerIndex);
    friendIdx = wrong[Math.floor(Math.random()*wrong.length)];
  }
  saveState();
  renderLifelines();
  showPhoneModal(friendIdx);
}

function showAudienceModal(percents){
  const letters = ['A','B','C','D'];
  const maxPx = 110;
  let html = '<p style="text-align:center;font-size:12px;color:#94a3b8;margin-bottom:6px">Hasil voting penonton:</p>';
  html += '<div class="audience-chart">';
  for(let i=0;i<4;i++){
    const h = Math.max(6, Math.round(percents[i] / 100 * maxPx));
    html += `
      <div class="aud-bar">
        <div class="aud-pct">${percents[i]}%</div>
        <div class="aud-fill" style="height:${h}px"></div>
        <div class="aud-letter">${letters[i]}</div>
      </div>`;
  }
  html += '</div>';
  showModal('👥 Tanya Penonton', html, [
    { label:'Tutup', class:'btn-primary', fn: closeModal }
  ]);
}

function showPhoneModal(friendIdx){
  const letters = ['A','B','C','D'];
  const body = `
    <p style="font-size:34px;text-align:center;margin:8px 0">📞</p>
    <p><b>"Halo! Menurut saya, jawabannya <span style="color:#60a5fa;font-size:17px">${letters[friendIdx]}</span>. Semoga membantu ya!"</b></p>
    <p class="hint">Teman Anda memberikan rekomendasi, keputusan tetap milik Anda.</p>
  `;
  showModal('📞 Telepon Teman', body, [
    { label:'Tutup', class:'btn-primary', fn: closeModal }
  ]);
}

